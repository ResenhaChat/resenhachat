    "express": "^5.2.1",
    "jsonwebtoken": "^9.0.2",
    "module-alias": "^2.3.4",
    "sharp": "^0.34.5",
    "web-push": "^3.6.7",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@cap-js/cds-typer": "^0.38.0",
    "@cap-js/cds-types": "^0.15.0",
    "@cap-js/sqlite": "^2",
    "@sap/cds-dk": "^9",
    "@types/express": "^5.0.6",
    "@types/jsonwebtoken": "^9.0.7",
    "@types/module-alias": "^2.0.4",
    "@types/node": "^25.2.1",
    "@types/web-push": "^3.6.4",
    "@types/ws": "^8.5.13",
    "mbt": "^1.2.49",
